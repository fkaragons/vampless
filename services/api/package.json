{
  "name": "@vampless/api",
  "version": "0.1.0",
  "private": true,
  "description": "Vampless registry API: preflight checks, image attestation, observed-token index, mint resolution, disputes",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node dist/server.js",
    "seed": "node --experimental-strip-types src/seed.ts",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@vampless/core": "*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
